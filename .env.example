# Banco / infra
# Porta 55432 (nao 5432): evita conflito com instancia nativa de Postgres no host.
# Ver docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/clinica
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_REMINDER_TEMPLATE_NAME=lembrete_consulta_24h # precisa existir e estar aprovado no WhatsApp Manager antes de funcionar de verdade

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash,gemini-3-flash-preview # lista ordenada separada por virgula — 429/5xx apos esgotar retry (ou 404) cai pro proximo; gemini-2.5-flash/gemini-2.5-pro aparecem na API mas sao recusados (404) em contas novas — confira `GET /v1beta/models` se mudar isso
LLM_MAX_ITERATIONS=5

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001 # confirmado na mao: aceita outputDimensionality, testado devolvendo exatamente 768 floats
EMBEDDING_DIMENSIONS=768 # acoplado a coluna "embedding vector(768)" — trocar exige migration + reingestao, nao e so trocar o numero aqui

# Regras de negocio
CLINIC_TIMEZONE=America/Fortaleza
MIN_LEAD_TIME_HOURS=2
MAX_LOOKAHEAD_DAYS=60
HOLD_TTL_MINUTES=10
LATE_CANCEL_HOURS=24
MESSAGE_DEBOUNCE_MS=3000
STUCK_MESSAGE_REPROCESS_MINUTES=15 # RN-16: mensagem presa por llm_error reprocessa sozinha apos esse tempo, se o paciente nao mandar outra antes
LLM_ERROR_ESCALATION_THRESHOLD=3 # RN-16: turnos CONSECUTIVOS terminados em llm_error ate escalar pra humano em vez de reprocessar pra sempre (achado do incidente de 2026-09-23)
RAG_SCORE_THRESHOLD=0.65 # calibrado contra o Gemini real — 0.35 deixava passar ate pergunta sem relacao nenhuma com a clinica (ver secao 11 da SPEC.md)
CONVERSATION_RETENTION_DAYS=180
RETENTION_PURGE_ENABLED=false # flag destrutiva (redige conversa+ticket, RN-22) — so "true" liga, qualquer outro valor falha a validacao. Producao liga explicitamente.
OUTBOX_DISPATCH_ENABLED=false # desligado (padrao fora de producao): DispatchOutboxJob loga e marca SENT em vez de chamar a WhatsApp Cloud API real — testa o caminho completo sem risco de enviar pra um dos poucos numeros de teste da Meta

# Painel administrativo
ADMIN_ORIGIN=http://localhost:3001
SESSION_COOKIE_NAME=clinica_session
SESSION_TTL_HOURS=12
SESSION_SECRET=
LOGIN_RATE_LIMIT=5/15m
AUDIT_DEDUP_WINDOW_SECONDS=60 # SEC-10: mesmo (ator,entidade,acao) dentro dessa janela nao gera 2a linha de AuditLog (polling do painel)

# App
PORT=3000
NODE_ENV=development
