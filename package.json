{
  "name": "clinica-api",
  "version": "0.1.0",
  "description": "Backend do agente de IA para clinica (WhatsApp + Agendamento + RAG)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=239",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.ts test/**/*.e2e-spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "seed:conversations": "ts-node --transpile-only prisma/run-seed-conversations.ts",
    "seed:appointments": "ts-node --transpile-only prisma/run-seed-appointments.ts",
    "knowledge:ingest": "ts-node --transpile-only scripts/ingest-knowledge.ts",
    "create-admin": "ts-node --transpile-only scripts/create-admin-user.ts",
    "check:repeatables": "ts-node --transpile-only scripts/check-repeatable-registration.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/run-seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "17.4.1",
    "ioredis": "^5.11.1",
    "luxon": "^3.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "cookie-signature": "^1.2.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "prisma": "^6.3.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
